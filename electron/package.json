{
  "name": "surrounded-by-ai-girls",
  "version": "0.1.0",
  "description": "完蛋，我被AI娘包围了 - 键盘同居恋爱喜剧",
  "main": "main.js",
  "author": "miaoyhcat",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.aigirls.gal",
    "productName": "完蛋我被AI娘包围了",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "game/**/*"],
    "afterPack": "afterPack.js",
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "完蛋我被AI娘包围了",
      "artifactName": "AI-Girls-Surrounded-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AI-Girls-Surrounded-Portable-${version}-${arch}.${ext}"
    },
    "artifactName": "AI-Girls-Surrounded-${version}-${arch}.${ext}"  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
